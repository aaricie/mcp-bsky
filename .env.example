BSKY_HANDLE=yourhandle.bsky.social
# Create an app password at bsky.app/settings/app-passwords.
# Enable direct-message access when creating it if you intend to use DM tools.
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# PDS / entryway base URL. Only change this if your account is hosted on a
# non-Bluesky PDS (self-hosted or third-party).
# BSKY_SERVICE=https://bsky.social

# Bind to localhost by default for safer local development. Change to 0.0.0.0
# only when you intentionally need the service reachable from another host.
MCP_HOST=127.0.0.1
MCP_PORT=8765

# --- Auth: set the header token, GitHub OAuth, or both (recommended). ---
# The endpoint is always /mcp; nothing secret goes in the URL.
#
# Static bearer token for CLIs and bots (Claude Code, Codex, scripts), sent as
# "Authorization: Bearer <token>". Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=
#
# GitHub OAuth for connector clients that can't send headers (ChatGPT,
# Claude apps). Create an OAuth app at github.com/settings/developers with
# callback URL <MCP_PUBLIC_URL>/auth/callback. Only the listed numeric GitHub
# user IDs get in (gh api user --jq .id).
#MCP_PUBLIC_URL=https://your.domain
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
#MCP_ALLOWED_GITHUB_IDS=
# Signs the OAuth tokens this server issues; set it so rotating the GitHub
# client secret doesn't log every client out. Same generator as above.
#MCP_JWT_SIGNING_KEY=
